# Скопируйте файл в .env: runner/start.py загрузит его автоматически.
HF_TOKEN=hf_change_me

# Рекомендуемые типичные переменные которые надо переопределить для запуска runner/start.py
GPU=0
BACKEND=llama_docker
BENCHMARK=gaia
MODEL=unsloth/Qwen3.5-0.8B-GGUF:Q4_K_M
PARALLEL=3
MODEL_CONTEXT_LIMIT=24000
MODEL_AVERAGE_TOKENS_PER_SECOND=20
PLAN=plans/default.csv

# Необязательные переопределения.
SAMPLE_TIME_LIMIT=1800
MESSAGE_LIMIT=100
TOOL_TIMEOUT=120
# WORKER_STALE_AFTER=120
# GPU_MEMORY_UTILIZATION=0.90
# VLLM_BIN=vllm
# TOOL_CALL_PARSER=qwen3_coder
# LLAMA_DOCKER_IMAGE=ghcr.io/ggml-org/llama.cpp:server
# MODEL_API_BASE_URL=https://api.example.com/v1
# MODEL_API_KEY=change_me

