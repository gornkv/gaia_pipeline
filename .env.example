# Скопируйте файл в .env: runner/worker.py загрузит его автоматически.
HF_TOKEN=hf_change_me

# Рекомендуемые типичные переменные которые надо переопределить для запуска runner/worker.py
GPU=0
MODEL_BACKEND=llama_docker
MODEL=unsloth/Qwen3.5-0.8B-GGUF:Q4_K_M
PARALLEL=3
MODEL_CONTEXT_LIMIT=24000
AVG_TOKENS_PER_SECOND=30
AVG_TOOL_COUNT=50
AVG_TOOL_TIME=30
PLAN=runner/default.csv

# Необязательные переопределения.
TOOL_TIMEOUT=120
MAX_CONSECUTIVE_REPEATS=5
# WORKER_STALE_AFTER=120
# GPU_MEMORY_UTILIZATION=0.90
# VLLM_BIN=vllm
# TOOL_CALL_PARSER=qwen3_coder
# LLAMA_DOCKER_IMAGE=ghcr.io/ggml-org/llama.cpp:server
# MODEL_EXTERNAL_API_URL=https://api.example.com/v1
# MODEL_EXTERNAL_API_KEY=change_me

