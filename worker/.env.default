WORKER_MODEL=unsloth/Qwen3.5-0.8B-GGUF:Q4_K_M
WORKER_BACKEND=llama
WORKER_SCAFFOLD=simple_middleware
WORKER_PARALLEL=1
WORKER_GPU_NUM=
WORKER_MODEL_CONTEXT_LIMIT=24000
WORKER_TOOL_SANDBOX=local
WORKER_STALE_AFTER=300
WORKER_HEARTBEAT_INTERVAL=15
WORKER_MODEL_ALIAS=
WORKER_NAME=

XDG_CACHE_HOME=${WORKER_ROOT}/_state/cache
XDG_DATA_HOME=${WORKER_ROOT}/_state/runtime/inspect_ai/data
HF_HOME=${XDG_CACHE_HOME}/huggingface
HF_XET_LOG_DEST=${WORKER_ROOT}/_state/logs/huggingface/xet/
PIP_CACHE_DIR=${XDG_CACHE_HOME}/pip
